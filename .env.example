# AI Provider configuration
AI_PROVIDER=gemini

# Optional: model to use. If omitted, Liz uses the provider default
# and falls back through a chain of known-good models.
# AI_MODEL=gemini-2.0-flash

# API Keys (configure at least one for cloud providers)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Local models via Ollama (no API key needed)
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Where to store local data (memory and notes databases)
DATA_DIR=data

# Web search works without configuration (DuckDuckGo HTML fallback).
# For better results install the optional extra: pip install -e ".[web]"

# Voice (Phase 7) — every engine is optional and auto-detected.
# STT: whisper.cpp (build it, then Liz finds it under whisper.cpp/)
# WHISPER_BIN=whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=whisper.cpp/models/ggml-base.bin
# TTS: first installed of spd-say / espeak-ng / espeak
VOICE_LANGUAGE=es
VOICE_RECORD_SECONDS=5
VOICE_WAKE_WORDS=hola liz, hey liz, oye liz

# Security: directories the tools may read/list/check and that
# run_command arguments must stay inside. Empty = home + working directory.
# FS_ROOTS=/home/you,/home/you/projects
